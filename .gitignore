# 虚拟环境与缓存
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
# 运行期数据库、锁、日志（日报与结构化 JSON 会提交）
data/news.db
data/news.db-*
data/.run.lock
logs/*
!logs/.gitkeep
# 系统与私人文件
.DS_Store
.env
.env.*
*.local.json
.claude/
*.pem
*.key
# 本机生成的 launchd 配置含绝对路径（用户名），不提交；模板见 scheduling/ainews.plist.template
scheduling/com.*.plist
